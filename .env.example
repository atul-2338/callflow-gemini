# Copy to .env and fill in. NEVER commit the real .env.
# On the VPS the live secrets already exist in /srv/callflow/.env — reuse those values.

# --- server -----------------------------------------------------------------
PORT=3000
# Bind address: 127.0.0.1 in production (nginx proxies to it), 0.0.0.0 locally.
HOST=0.0.0.0
APP_BASE_URL=http://localhost:3000
# Public origin used for canonical URLs / sitemap (no trailing slash).
PUBLIC_SITE_URL=https://callflow.biz

# --- database (KEEP OUTSIDE THE GIT CHECKOUT IN PRODUCTION) -----------------
# e.g. SQLITE_PATH=/var/data/callflow-gemini/callflow.db
SQLITE_PATH=./data/callflow.db

# --- super-admin dashboard (/admin) -----------------------------------------
ADMIN_EMAIL=admin@callflow.biz
ADMIN_PASSWORD=change-me

# --- Dograh (AI voice agent) ------------------------------------------------
DOGRAH_BASE_URL=http://localhost:3010
DOGRAH_API_KEY=
# Shared secret Dograh must send as x-webhook-secret on POST /webhooks/dograh/lead
DOGRAH_WEBHOOK_SECRET=

# --- Telnyx (number inventory only; no API calls are made) ------------------
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=

# --- Web Push (VAPID) -------------------------------------------------------
# Generate with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@callflow.biz

# --- Dodo Payments (billing) ------------------------------------------------
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PLAN_SOLO_ID=

# --- optional overrides ------------------------------------------------------
# DEMO_LOGIN_ENABLED=true
# DEMO_LOGIN_EMAIL=demo@callflow.biz
# DEMO_LOGIN_PASSWORD=CallFlowDemo!
# COOKIE_SECURE=true
